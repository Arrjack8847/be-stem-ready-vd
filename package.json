{
  "name":"bsr-who-is",
  "version":"1.0.0",
  "private":true,
  "description":"Cinematic Be STEM Ready company-profile film built with Remotion",
  "scripts":{
    "prepare:hook":"node scripts/prepare-hook-assets.mjs",
    "prepare:who":"node scripts/prepare-who-assets.mjs",
    "prepare:media":"npm run prepare:hook && npm run prepare:who",
    "prestart":"npm run prepare:media",
    "start":"remotion studio --no-open",
    "check":"tsc --noEmit",
    "prerender":"npm run prepare:media",
    "render":"remotion render src/index.ts FullFilm out/bsr-full-film.mp4 --codec=h264 --crf=18",
    "prerender:hook":"npm run prepare:hook",
    "render:hook":"remotion render src/index.ts CinematicHook out/cinematic-hook.mp4 --codec=h264 --crf=18",
    "prerender:who":"npm run prepare:who",
    "render:who":"remotion render src/index.ts WhoIsBSR out/who-is-bsr.mp4 --codec=h264 --crf=18",
    "still":"remotion still src/index.ts FullFilm out/preview.png --frame=420"
  },
  "dependencies":{"@fontsource-variable/space-grotesk":"^5.3.0","@fontsource/inter":"^5.3.0","@remotion/cli":"4.0.529","@remotion/media":"4.0.529","@remotion/transitions":"4.0.529","react":"19.2.4","react-dom":"19.2.4","remotion":"4.0.529"},
  "devDependencies":{"@types/react":"19.2.14","@types/react-dom":"19.2.3","typescript":"5.9.3"}
}
