{
  "name": "bsr-who-is",
  "version": "1.0.0",
  "private": true,
  "description": "A 21-second cinematic Be STEM Ready identity sequence",
  "scripts": {
    "start": "remotion studio --no-open",
    "check": "tsc --noEmit",
    "render": "remotion render src/index.ts WhoIsBSR out/who-is-bsr.mp4 --codec=h264 --crf=18",
    "still": "remotion still src/index.ts WhoIsBSR out/preview.png --frame=60"
  },
  "dependencies": {
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@remotion/cli": "4.0.529",
    "@remotion/media": "4.0.529",
    "@remotion/transitions": "4.0.529",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "remotion": "4.0.529"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3"
  }
}
